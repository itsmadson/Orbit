# ---------------------------------------------------------------------------
# ORBIT — copy to .env before starting:  cp .env.example .env
# ---------------------------------------------------------------------------

# Environment: development | production
ENV=development

# --- Database -------------------------------------------------------------
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_DB=orbit
# Host port for psql access (container port is always 5432)
POSTGRES_PORT_EXTERNAL=5433

# --- Ports ----------------------------------------------------------------
WEB_PORT=3000
API_PORT=8000

# --- Security -------------------------------------------------------------
# CHANGE THIS before any real deployment: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=600

# --- Demo data ------------------------------------------------------------
# Seeds a full demo company on first boot. Set to false for an empty workspace.
SEED_ON_STARTUP=true
DEMO_PASSWORD=orbit1234

# --- AI provider ----------------------------------------------------------
# deterministic = no external model; answers only from company records.
# openai        = any OpenAI-compatible endpoint (set AI_BASE_URL + AI_API_KEY)
# ollama        = local models (set AI_BASE_URL=http://host.docker.internal:11434)
AI_PROVIDER=deterministic
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- AI assistant (agent) ---------------------------------------------------
# Any OpenAI-compatible chat API; GapGPT by default. With a key set, Orbit AI
# becomes an agent that can read AND change the workspace (as the asking user,
# with their permissions). Without a key it falls back to AI_PROVIDER above.
ASSISTANT_API_BASE=https://api.gapgpt.app/v1
GAPGPT_API_KEY=
# ASSISTANT_API_KEY=            # takes precedence over GAPGPT_API_KEY
ASSISTANT_MODEL=glm-4-flash
# auto = native function calling, falling back to prompt-described tools
ASSISTANT_TOOL_MODE=auto
ASSISTANT_TEMPERATURE=0.3
ASSISTANT_TIMEOUT=120
ASSISTANT_MAX_STEPS=6
ASSISTANT_DAILY_LIMIT=100
ASSISTANT_MAX_INPUT=4000

# --- Integrations (GitHub, GitLab, Jira) ----------------------------------
# Connected in Settings → Integrations; tokens are stored encrypted with a key
# derived from SECRET_KEY. These only tune the background sync.
INTEGRATION_SYNC_ENABLED=true
INTEGRATION_SYNC_SECONDS=300
# HTTPS_PROXY=http://host.docker.internal:10809

# --- File storage ---------------------------------------------------------
# local = volume-backed files; s3 = any S3-compatible store (MinIO, AWS, …)
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_BUCKET=orbit
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Branding -------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=ORBIT
